<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Base Gamer — Inicio</title>

  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700&family=Orbitron:wght@500;700&family=Roboto:wght@300;400;500&display=swap" rel="stylesheet">

  <!-- Hoja de estilos externa (ruta absoluta) -->
  <link rel="stylesheet" href="/styles.css">

  <!-- Comentario: estilos mínimos adicionales para map responsiveness de prototipo -->
  <style>
    /* Si tu styles.css ya cubre .hero, .art, etc., estos estilos no sobrescriben mucho.
       Aquí solo damos una pautita para que el mapa se vea bien en el prototipo. */
    .banner-map-wrap{max-width:1200px;margin:0 auto;border-radius:12px;overflow:hidden}
    .banner-map-wrap img{display:block;width:100%;height:auto}
    /* Nota: los <area> usan coords en px. Para producción considera SVG responsivo o librería. */
  </style>
</head>
<body>
  <div class="container">

    <!-- Header con navegación y mailto -->
    <header>
      <div class="logo">
        <div class="mark">BG</div>
        <div>
          <h1>BaseGamer</h1>
          <p>Añadir - Modificar - Juegos</p>
        </div>
      </div>

      <nav>
        <button class="nav-toggle" aria-expanded="false" aria-controls="navMenu" type="button">☰ Menú</button>
        <div id="navMenu" class="nav-menu">
          <a href="/home">Inicio</a>
          <a href="/catalogo">Catálogo</a>
          <a href="/agregar">Agregar</a>
          <a href="/modificar">Modificar</a>
          <form class="search" role="search" method="get" action="/home" style="position:relative;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden><path d="M21 21l-4.35-4.35" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <input name="q" id="searchHome" placeholder="Buscar juegos..." aria-label="Buscar" value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>">
            <button type="submit" style="display:none"></button>
            <div id="suggestionsHome" class="search-suggestions" style="position:absolute;top:42px;left:0;right:0;z-index:10"></div>
          </form>
          <% if (typeof isAuthenticated !== 'undefined' && isAuthenticated) { %>
            <a href="/logout">Cerrar sesión<% if (username) { %> (<%= username %>)<% } %></a>
          <% } %>
        </div>
      </nav>
    </header>

    <main>
      <% if (typeof searchQuery !== 'undefined' && searchQuery) { %>
        <section id="resultados" class="section">
          <h3>Resultados de búsqueda para "<%= searchQuery %>"</h3>
          <div class="grid">
            <% if (juegos && juegos.length) { %>
              <% juegos.forEach(juego => { %>
                <article class="card">
                  <div class="thumb"><img src="<%= juego.imagen %>" alt="<%= juego.nombre %>"></div>
                  <h4 class="title"><%= juego.nombre %></h4>
                  <div class="meta">
                    <div class="price">$<%= juego.precio %></div>
                  </div>
                  <p style="color:var(--muted);font-size:13px;margin:6px 0 0;"><%= juego.descripcion %></p>
                  <div class="actions">
                    <a href="/detalles/<%= juego.id %>" class="small-btn add">Detalles</a>
                  </div>
                </article>
              <% }) %>
            <% } else { %>
              <p style="color:var(--muted);text-align:center;width:100%;">No se encontraron resultados.</p>
            <% } %>
          </div>
        </section>
      <% } %>
      <!-- HERO / BANNER con mapa de imagen activo -->
      <section class="hero">
        <div class="left">
          <h2>Sumérgete en la próxima generación de juegos</h2>
          <p>Base de Datos de videojuegos, añade, modifica y elimina. Crea tu propia base de datos de videojuegos con BaseGamer.</p>
          <div class="cta">
            <a href="/catalogo" class="btn btn-ghost" role="button">Ver catálogo</a>
            <a href="/agregar" class="btn btn-ghost" role="button">Agregar juego</a>
            <a href="/modificar" class="btn btn-ghost" role="button">Modificar juego</a>
          </div>
        </div>

        <!-- Banner con mapa de imagen (imagen libre Unsplash) -->
        <div class="art banner-map-wrap">
          <!--
            Comentario importante:
            - La imagen proviene de Unsplash (uso libre) y se usa aquí como ejemplo.
            - El atributo usemap="#banner-map" conecta con <map> definido abajo.
            - Los coords son aproximados para una anchura ~1200px — ajusta si cambias la imagen.
          -->
          <img src="/img/logo.png" alt="Banner gaming" usemap="#banner-map" width="1200" height="500">

          <!-- Mapa de imagen: tres áreas clicables -->
          <map name="banner-map" id="banner-map">
            <!-- Área 1: zona izquierda (ej. control) -> Catálogo -->
            <area shape="rect" coords="40,280,360,460" href="/catalogo" alt="Ir a Catálogo" title="Ir a Catálogo">
            
          </map>
        </div>
      </section>

      <!-- SECCIÓN: OFERTAS DESTACADAS (con id para marcador) -->
      <section id="ofertas" class="section">
        <h3>Ofertas destacadas</h3>
        <div class="grid">
          <% if (juegos && juegos.length > 0) { %>
            <% juegos.forEach(juego => { %>
              <article class="card">
                <div class="thumb"><img src="<%= juego.imagen %>" alt="<%= juego.nombre %>"></div>
                <h4 class="title"><%= juego.nombre %></h4>
                <div class="meta">
                  <div class="price">$<%= juego.precio %></div>
                </div>
                <p style="color:var(--muted);font-size:13px;margin:6px 0 0;"><%= juego.descripcion %></p>
                <div class="actions">
                  <a href="/detalles/<%= juego.id %>" class="small-btn add">Detalles</a>
                </div>
              </article>
            <% }); %>
          <% } else { %>
            <p style="color:var(--muted);text-align:center;width:100%;">No hay productos disponibles en este momento.</p>
          <% } %>
        </div>
      </section>

          <script>
            // Live suggestions para /home
            (function(){
              const input = document.getElementById('searchHome');
              const box = document.getElementById('suggestionsHome');
              if (!input || !box) return;
              let t;
              input.addEventListener('input', () => {
                clearTimeout(t);
                const q = input.value.trim();
                if (!q) { box.innerHTML = ''; return; }
                t = setTimeout(async () => {
                  try {
                    const res = await fetch(`/buscar?q=${encodeURIComponent(q)}`);
                    const data = await res.json();
                    const items = (data.results || []).slice(0,6).map(r => `
                      <a href="/detalles/${r.id}" class="suggestion-item">
                        <img src="${r.imagen}" alt="${r.nombre}" class="suggestion-thumb">
                        <div class="suggestion-text">
                          <div class="suggestion-title">${r.nombre}</div>
                          <div class="suggestion-price">$${r.precio || ''}</div>
                        </div>
                      </a>`).join('');
                    box.innerHTML = items;
                  } catch (e) {
                    box.innerHTML = '';
                  }
                }, 250);
              });
            })();
            // Toggle menú responsive
            (function(){
              const toggle = document.querySelector('.nav-toggle');
              const menu = document.getElementById('navMenu');
              if(!toggle || !menu) return;
              toggle.addEventListener('click', () => {
                const open = menu.classList.toggle('open');
                toggle.setAttribute('aria-expanded', open);
              });
            })();
          </script>

      <!-- SECCIÓN: CONTACTO (marcador) -->
      <section id="contacto" class="section" style="margin-top:24px;">
        <h3>Contacto</h3>
        <p style="color:var(--muted);margin-bottom:12px;">¿Dudas o sugerencias? Escríbenos.</p>

        <!-- Enlace mailto con asunto y cuerpo ejemplo -->
        <p>
          <a href="mailto:BaseGamer.EBA@hotmail.com?subject=Consulta%20BaseGamer&body=Hola%20BaseGamer%2C%0A%0AQuisiera%20saber%20...">
            ✉️ BaseGamer.EBA@hotmail.com
          </a>
        </p>

        <!-- Pequeña info adicional / mapa estático (puedes reemplazar por mapa real) -->
        <p style="color:var(--muted);font-size:13px;">Dirección (): Av. Gomez 123, Santiago Papasquiaro — México</p>
      </section>

      <!-- FOOTER con mailto y créditos -->
      <footer style="margin-top:18px;color:var(--muted);font-size:13px;text-align:center">
        <p>© 2025 BaseGamer</p>
        <p>Contacto rápido: <a href="mailto:BaseGamer.EBA@hotmail.com">BaseGamer.EBA@hotmail.com</a></p>
      </footer>

    </main>
  </div>

  <!-- Comentario final:
       - Las páginas multimedia que enlazan las tarjetas (juego_horizon.html, juego_forest.html, juego_ghost.html, juego_residentevil.html)
         las genero por separado cuando quieras (cada una incluirá: iframe de YouTube ficticio, galería de imágenes y requisitos).
       - Ajusta coords del <map> si cambias la imagen por otra con proporciones distintas.
  -->
</body>
</html>
