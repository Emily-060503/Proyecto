<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Horizon Forbidden West — TiendaGamer</title>

  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700&family=Orbitron:wght@500;700&family=Roboto:wght@300;400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="styles.css">

  <style>
    .media-container{display:flex;flex-direction:column;align-items:center;gap:20px;margin:30px auto;max-width:900px;text-align:center}
    video{width:100%;height:auto;border-radius:14px;box-shadow:0 0 20px rgba(0,0,0,0.5);outline:none}
    .gallery{position:relative;max-width:700px;margin:auto}
    .gallery img{width:100%;height:auto;border-radius:12px;display:block}
    .gallery button{position:absolute;top:50%;transform:translateY(-50%);background:rgba(0,0,0,0.6);border:0;color:white;padding:10px;border-radius:50%;cursor:pointer}
    .gallery button:hover{background:rgba(0,0,0,0.8)}
    .prev{left:10px}
    .next{right:10px}
    .info{max-width:800px;margin:auto;text-align:left;line-height:1.6}
    .requirements{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:20px}
    .req-box{background:rgba(255,255,255,0.03);padding:12px;border-radius:10px}
    a.btn-back{display:inline-block;margin-top:20px;padding:10px 16px;border-radius:10px;background:var(--accent-blue);color:white;text-decoration:none;font-weight:600}
  </style>
</head>
<body>
  <div class="container">
    <header>
      <div class="logo">
        <div class="mark">G</div>
        <div>
          <h1>TiendaGamer</h1>
          <p>Juegos — Ofertas — Comunidad</p>
        </div>
      </div>
    </header>

    <main class="media-container">
      <h2>Horizon Forbidden West™ — Complete Edition</h2>

      <!-- 🎥 Video local (tráiler almacenado en carpeta media/) -->
      <!-- Usa un archivo real, por ejemplo media/horizon_trailer.mp4 -->
      <video controls poster="img/horizon1.jpg">
        <source src="media/horizon_trailer.mp4" type="video/mp4">
        Tu navegador no soporta la reproducción de video.
      </video>

      <!-- 🖼️ Galería de imágenes -->
      <div class="gallery">
        <img id="galeria" src="img/horizon1.jpg" alt="Horizon screenshot 1">
        <button class="prev" onclick="cambiar(-1)">❮</button>
        <button class="next" onclick="cambiar(1)">❯</button>
      </div>

      <!-- ℹ️ Descripción + Requisitos -->
      <div class="info">
        <p>Explora tierras majestuosas, enfrenta criaturas mecánicas y descubre los secretos del Oeste Prohibido junto a Aloy. Esta edición incluye la expansión “Burning Shores”.</p>

        <div class="requirements">
          <div class="req-box">
            <h4>Requisitos mínimos</h4>
            <ul>
              <li>SO: Windows 10 64-bit</li>
              <li>CPU: Intel i5-8400 o AMD Ryzen 5 2600</li>
              <li>RAM: 16 GB</li>
              <li>GPU: NVIDIA GTX 1060 6 GB o AMD RX 580 8 GB</li>
              <li>Almacenamiento: 100 GB</li>
            </ul>
          </div>
          <div class="req-box">
            <h4>Requisitos recomendados</h4>
            <ul>
              <li>SO: Windows 11 64-bit</li>
              <li>CPU: Intel i7-10700K o Ryzen 7 3700X</li>
              <li>RAM: 32 GB</li>
              <li>GPU: NVIDIA RTX 3070 o AMD RX 6800 XT</li>
              <li>Almacenamiento: SSD 100 GB</li>
            </ul>
          </div>
        </div>
      </div>

      <!-- 🔗 Enlace de regreso -->
      <a href="index.html" class="btn-back">← Volver al inicio</a>
    </main>

    <footer>
      © 2025 TiendaGamer 
    </footer>
  </div>

  <script>
    // 📸 Script sencillo para cambiar imágenes de la galería
    const imagenes = ["img/horizon1.jpg","img/horizon2.jpg","img/horizon3.jpg"];
    let indice = 0;
    function cambiar(d){
      indice = (indice + d + imagenes.length) % imagenes.length;
      document.getElementById("galeria").src = imagenes[indice];
    }
  </script>
</body>
</html>
