<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Agregar Juego — TiendaGamer</title>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700&family=Orbitron:wght@500;700&family=Roboto:wght@300;400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <div class="container">
        <header>
            <div class="logo">
                <div class="mark">G</div>
                <div>
                    <h1>TiendaGamer</h1>
                    <p>Agregar Juego</p>
                </div>
            </div>
            <nav>
                <a href="/">Inicio</a>
                <a href="/catalogo">Catálogo</a>
                <a href="/agregar" class="active">Agregar</a>
                <a href="/modificar">Modificar</a>
            </nav>
        </header>

    <main class="form-container">
        <!-- Formulario envía a POST /agregar (asegúrate de tener la ruta en el servidor) -->
        <form class="formulario" method="post" action="/agregar">

            <% if (typeof errors !== 'undefined' && errors && errors.length) { %>
                <div class="errors" style="color:#ffb4b4;margin-bottom:12px;">
                    <ul>
                        <% errors.forEach(function(err){ %>
                            <li><%= err %></li>
                        <% }) %>
                    </ul>
                </div>
            <% } %>

            <% if (typeof success !== 'undefined' && success) { %>
                <div class="success" style="color:var(--accent-green);margin-bottom:12px;"><%= success %></div>
            <% } %>

            <label for="name">Nombre del juego:</label>
            <input id="name" name="name" type="text" placeholder="Ejemplo: God of War" required value="<%= typeof game !== 'undefined' && game.name ? game.name : '' %>">

            <label for="description">Descripción:</label>
            <textarea id="description" name="description" placeholder="Breve descripción del juego" required><%= typeof game !== 'undefined' && game.description ? game.description : '' %></textarea>

            <label for="price">Precio (USD):</label>
            <input id="price" name="price" type="number" step="0.01" placeholder="Ejemplo: 59.99" required value="<%= typeof game !== 'undefined' && game.price ? game.price : '' %>">

            <label for="platform">Plataforma o Categoría:</label>
            <input id="platform" name="platform" type="text" placeholder="Ejemplo: PlayStation, Xbox, PC" required value="<%= typeof game !== 'undefined' && game.platform ? game.platform : '' %>">

            <label for="imageUrl">Link de imagen del juego:</label>
            <input id="imageUrl" name="imageUrl" type="url" placeholder="https://imagen-del-juego.com" required value="<%= typeof game !== 'undefined' && game.imageUrl ? game.imageUrl : '' %>">

            <button type="submit" class="btn">Guardar Juego</button>
        </form>
    </main>

        <footer>
            <p>&copy; 2025 TiendaGamer</p>
            <p>Contacto: <a href="mailto:lbhd17@hotmail.com">lbhd17@hotmail.com</a></p>
        </footer>
    </div>
</body>
</html>
