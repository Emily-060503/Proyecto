<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Agregar Juego — TiendaGamer</title>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700&family=Orbitron:wght@500;700&family=Roboto:wght@300;400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <div class="container">
        <header>
            <div class="logo">
                <div class="mark">BG</div>
                <div>
                    <h1>BaseGamer</h1>
                    <p>Agregar Juego</p>
                </div>
            </div>
               <nav>
                    <a href="/modificar">Modificar</a>
                    <a href="/agregar">Agregar</a>
                    <a href="/home">Inicio</a>
                    <a href="/catalogo">Catálogo</a>

                    <form class="search" role="search" method="get" action="/catalogo" style="position:relative;">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden><path d="M21 21l-4.35-4.35" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    <input name="q" id="searchCatalogo" placeholder="Buscar juegos..." aria-label="Buscar" value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>">
                    <button type="submit" style="display:none"></button>
                    <div id="suggestionsCatalogo" class="search-suggestions" style="position:absolute;top:42px;left:0;right:0;z-index:10"></div>
                    </form>
                </nav>
        </header>

    <main class="form-container">
        <!-- Formulario envía a POST /agregar (asegúrate de tener la ruta en el servidor) -->
        <form class="formulario" method="post" action="/agregar">

            <% if (typeof errors !== 'undefined' && errors && errors.length) { %>
                <div class="errors" style="color:#ffb4b4;margin-bottom:12px;grid-column:1/-1;">
                    <ul>
                        <% errors.forEach(function(err){ %>
                            <li><%= err %></li>
                        <% }) %>
                    </ul>
                </div>
            <% } %>

            <% if (typeof success !== 'undefined' && success) { %>
                <div class="success" style="color:var(--accent-green);margin-bottom:12px;grid-column:1/-1;"><%= success %></div>
            <% } %>

            <!-- Columna 1: Información básica -->
            <div class="form-column">
                <h3 style="grid-column:1/-1;color:var(--accent-purple);margin-bottom:8px;">Información Básica</h3>
                
                <label for="nombre">Nombre del juego:</label>
                <input id="nombre" name="nombre" type="text" placeholder="Ejemplo: God of War" required value="<%= typeof productos !== 'undefined' && productos && productos.nombre ? productos.nombre : '' %>">

                <label for="descripcion">Descripción:</label>
                <textarea id="descripcion" name="descripcion" placeholder="Breve descripción del juego" required><%= typeof productos !== 'undefined' && productos && productos.descripcion ? productos.descripcion : '' %></textarea>

                <label for="precio">Precio (USD):</label>
                <input id="precio" name="precio" type="number" step="0.01" placeholder="Ejemplo: 59.99" required value="<%= typeof productos !== 'undefined' && productos && productos.precio ? productos.precio : '' %>">

                <label for="imagen">Link de imagen del juego:</label>
                <input id="imagen" name="imagen" type="url" placeholder="https://imagen-del-juego.com" required value="<%= typeof productos !== 'undefined' && productos && productos.imagen ? productos.imagen : '' %>">

                <label for="video">Video de pestaña Detalles:</label>
                <input id="video" name="video" type="text" placeholder="https://video-del-juego.com" value="<%= typeof productos !== 'undefined' && productos && productos.video ? productos.video : '' %>">

                <label for="imagen1">Imagen 1 para detalles:</label>
                <input id="imagen1" name="imagen1" type="text" placeholder="https://imagen1-del-juego.com" value="<%= typeof productos !== 'undefined' && productos && productos.imagen1 ? productos.imagen1 : '' %>">

                <label for="imagen2">Imagen 2 para detalles:</label>
                <input id="imagen2" name="imagen2" type="text" placeholder="https://imagen2-del-juego.com" value="<%= typeof productos !== 'undefined' && productos && productos.imagen2 ? productos.imagen2 : '' %>">

                <label for="detalles">Descripcion o detalles para pestaña detalles:</label>
                <input id="detalles" name="detalles" type="text" placeholder="Detalles del juego" value="<%= typeof productos !== 'undefined' && productos && productos.detalles ? productos.detalles : '' %>">
            </div>

            <!-- Columna 2: Requisitos del sistema -->
            <div class="form-column">
                <h3 style="color:var(--accent-purple);margin-bottom:8px;">Requisitos del Sistema</h3>
                
                <h4 style="color:var(--accent-blue);margin-top:12px;margin-bottom:8px;">Requisitos Mínimos</h4>
                
                <label for="min_SO">SO:</label> 
                <input id="min_SO" name="min_SO" type="text" placeholder="Sistema Operativo mínimo" value="<%= typeof productos !== 'undefined' && productos && productos.min_SO ? productos.min_SO : '' %>">
                
                <label for="min_CPU">CPU:</label>
                <input id="min_CPU" name="min_CPU" type="text" placeholder="CPU mínimo" value="<%= typeof productos !== 'undefined' && productos && productos.min_CPU ? productos.min_CPU : '' %>">
                
                <label for="min_RAM">RAM:</label>
                <input id="min_RAM" name="min_RAM" type="text" placeholder="RAM mínima" value="<%= typeof productos !== 'undefined' && productos && productos.min_RAM ? productos.min_RAM : '' %>">  
                
                <label for="min_GPU">GPU:</label>
                <input id="min_GPU" name="min_GPU" type="text" placeholder="GPU mínima" value="<%= typeof productos !== 'undefined' && productos && productos.min_GPU ? productos.min_GPU : '' %>">
                
                <label for="min_ALM">Almacenamiento:</label>
                <input id="min_ALM" name="min_ALM" type="text" placeholder="Almacenamiento mínimo" value="<%= typeof productos !== 'undefined' && productos && productos.min_ALM ? productos.min_ALM : '' %>">   

                <h4 style="color:var(--accent-blue);margin-top:16px;margin-bottom:8px;">Requisitos Recomendados</h4>
                
                <label for="rec_SO">SO:</label> 
                <input id="rec_SO" name="rec_SO" type="text" placeholder="Sistema Operativo recomendado" value="<%= typeof productos !== 'undefined' && productos && productos.rec_SO ? productos.rec_SO : '' %>">
                
                <label for="rec_CPU">CPU:</label>
                <input id="rec_CPU" name="rec_CPU" type="text" placeholder="CPU recomendado" value="<%= typeof productos !== 'undefined' && productos && productos.rec_CPU ? productos.rec_CPU : '' %>">
                
                <label for="rec_RAM">RAM:</label>
                <input id="rec_RAM" name="rec_RAM" type="text" placeholder="RAM recomendada" value="<%= typeof productos !== 'undefined' && productos && productos.rec_RAM ? productos.rec_RAM : '' %>">  
                
                <label for="rec_GPU">GPU:</label>
                <input id="rec_GPU" name="rec_GPU" type="text" placeholder="GPU recomendada" value="<%= typeof productos !== 'undefined' && productos && productos.rec_GPU ? productos.rec_GPU : '' %>">
                
                <label for="rec_ALM">Almacenamiento:</label>
                <input id="rec_ALM" name="rec_ALM" type="text" placeholder="Almacenamiento recomendado" value="<%= typeof productos !== 'undefined' && productos && productos.rec_ALM ? productos.rec_ALM : '' %>">
            </div>

            <button type="submit" class="btn" style="grid-column:1/-1;margin-top:20px;">Guardar Juego</button>
        </form>
    </main>

        <footer>
            <p>&copy; 2025 BaseGamer</p>
            <p>Contacto: <a href="mailto:BaseGamer.EBA@hotmail.com">BaseGamer.EBA@hotmail.com</a></p>
        </footer>
    </div>
        <script>
            // Live suggestions para el buscador del header en /agregar (igual que /catalogo)
            (function(){
                const input = document.getElementById('searchCatalogo');
                const box = document.getElementById('suggestionsCatalogo');
                if (!input || !box) return;
                let t;
                input.addEventListener('input', () => {
                    clearTimeout(t);
                    const q = input.value.trim();
                    if (!q) { box.innerHTML = ''; return; }
                    t = setTimeout(async () => {
                        try {
                            const res = await fetch(`/buscar?q=${encodeURIComponent(q)}`);
                            const data = await res.json();
                            const items = (data.results || []).slice(0,6).map(r => `
                                <a href="/detalles/${r.id}" class="suggestion-item">
                                    <img src="${r.imagen}" alt="${r.nombre}" class="suggestion-thumb">
                                    <div class="suggestion-text">
                                        <div class="suggestion-title">${r.nombre}</div>
                                        <div class="suggestion-price">$${r.precio || ''}</div>
                                    </div>
                                </a>`).join('');
                            box.innerHTML = items;
                        } catch (e) {
                            box.innerHTML = '';
                        }
                    }, 250);
                });
            })();
        </script>
</body>
</html>
