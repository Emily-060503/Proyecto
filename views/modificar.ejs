<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Modificar Juego — TiendaGamer</title>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700&family=Orbitron:wght@500;700&family=Roboto:wght@300;400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <div class="container">
        <header>
            <div class="logo">
                <div class="mark">BG</div>
                <div>
                    <h1>BaseGamer</h1>
                    <p>Modificar Juego</p>
                </div>
            </div>
            <nav>
                <a href="/">Inicio</a>
                <a href="/catalogo">Catálogo</a>
                <a href="/agregar">Agregar</a>
                <a href="/modificar" class="active">Modificar</a>
            </nav>
        </header>

    <main class="form-container">
        <% if (typeof errors !== 'undefined' && errors && errors.length) { %>
            <div class="errors" style="color:#ffb4b4;margin-bottom:12px;grid-column:1/-1;">
                <ul>
                    <% errors.forEach(function(err){ %>
                        <li><%= err %></li>
                    <% }) %>
                </ul>
            </div>
        <% } %>

        <% if (typeof success !== 'undefined' && success) { %>
            <div class="success" style="color:var(--accent-green);margin-bottom:12px;grid-column:1/-1;"><%= success %></div>
        <% } %>

        <!-- Formulario de búsqueda -->
        <% if (!game || !game.id) { %>
            <form class="formulario" method="get" action="/modificar" style="margin-bottom:20px;display:flex;flex-direction:column;position:relative;">
                <label for="searchModificar">Buscar juego por nombre:</label>
                <div style="display:flex;gap:8px;">
                    <input id="searchModificar" name="q" type="text" placeholder="Ejemplo: God of War" required style="flex:1;">
                    <button type="submit" class="btn">Buscar</button>
                </div>
                <div id="suggestionsModificar" class="search-suggestions" style="position:absolute;top:78px;left:0;right:0;z-index:10"></div>
            </form>
        <% } %>

        <!-- Formulario de modificación (se muestra si hay un juego) -->
        <% if (game && game.id) { %>
            <form class="formulario" method="post" action="/modificar/<%= game.id %>">
                <input type="hidden" name="id" value="<%= game.id %>">

                <!-- Columna 1: Información básica -->
                <div class="form-column">
                    <h3 style="color:var(--accent-purple);margin-bottom:8px;">Información Básica</h3>
                    
                    <label for="nombre">Nombre del juego:</label>
                    <input id="nombre" name="nombre" type="text" placeholder="Ejemplo: God of War" required value="<%= typeof game !== 'undefined' && game && game.nombre ? game.nombre : '' %>">

                    <label for="descripcion">Descripción:</label>
                    <textarea id="descripcion" name="descripcion" placeholder="Breve descripción del juego" required><%= typeof game !== 'undefined' && game && game.descripcion ? game.descripcion : '' %></textarea>

                    <label for="precio">Precio (USD):</label>
                    <input id="precio" name="precio" type="number" step="0.01" placeholder="Ejemplo: 59.99" required value="<%= typeof game !== 'undefined' && game && game.precio ? game.precio : '' %>">

                    <label for="imagen">Link de imagen del juego:</label>
                    <input id="imagen" name="imagen" type="url" placeholder="https://imagen-del-juego.com" required value="<%= typeof game !== 'undefined' && game && game.imagen ? game.imagen : '' %>">

                    <label for="video">Video de pestaña Detalles:</label>
                    <input id="video" name="video" type="text" placeholder="https://video-del-juego.com" value="<%= typeof game !== 'undefined' && game && game.video ? game.video : '' %>">

                    <label for="imagen1">Imagen 1 para detalles:</label>
                    <input id="imagen1" name="imagen1" type="text" placeholder="https://imagen1-del-juego.com" value="<%= typeof game !== 'undefined' && game && game.imagen1 ? game.imagen1 : '' %>">

                    <label for="imagen2">Imagen 2 para detalles:</label>
                    <input id="imagen2" name="imagen2" type="text" placeholder="https://imagen2-del-juego.com" value="<%= typeof game !== 'undefined' && game && game.imagen2 ? game.imagen2 : '' %>">

                    <label for="detalles">Descripcion o detalles para pestaña detalles:</label>
                    <input id="detalles" name="detalles" type="text" placeholder="Detalles del juego" value="<%= typeof game !== 'undefined' && game && game.detalles ? game.detalles : '' %>">
                </div>

                <!-- Columna 2: Requisitos del sistema -->
                <div class="form-column">
                    <h3 style="color:var(--accent-purple);margin-bottom:8px;">Requisitos del Sistema</h3>
                    
                    <h4 style="color:var(--accent-blue);margin-top:12px;margin-bottom:8px;">Requisitos Mínimos</h4>
                    
                    <label for="min_SO">SO:</label> 
                    <input id="min_SO" name="min_SO" type="text" placeholder="Sistema Operativo mínimo" value="<%= typeof game !== 'undefined' && game && game.min_SO ? game.min_SO : '' %>">
                    
                    <label for="min_CPU">CPU:</label>
                    <input id="min_CPU" name="min_CPU" type="text" placeholder="CPU mínimo" value="<%= typeof game !== 'undefined' && game && game.min_CPU ? game.min_CPU : '' %>">
                    
                    <label for="min_RAM">RAM:</label>
                    <input id="min_RAM" name="min_RAM" type="text" placeholder="RAM mínima" value="<%= typeof game !== 'undefined' && game && game.min_RAM ? game.min_RAM : '' %>">  
                    
                    <label for="min_GPU">GPU:</label>
                    <input id="min_GPU" name="min_GPU" type="text" placeholder="GPU mínima" value="<%= typeof game !== 'undefined' && game && game.min_GPU ? game.min_GPU : '' %>">
                    
                    <label for="min_ALM">Almacenamiento:</label>
                    <input id="min_ALM" name="min_ALM" type="text" placeholder="Almacenamiento mínimo" value="<%= typeof game !== 'undefined' && game && game.min_ALM ? game.min_ALM : '' %>">   

                    <h4 style="color:var(--accent-blue);margin-top:16px;margin-bottom:8px;">Requisitos Recomendados</h4>
                    
                    <label for="rec_SO">SO:</label> 
                    <input id="rec_SO" name="rec_SO" type="text" placeholder="Sistema Operativo recomendado" value="<%= typeof game !== 'undefined' && game && game.rec_SO ? game.rec_SO : '' %>">
                    
                    <label for="rec_CPU">CPU:</label>
                    <input id="rec_CPU" name="rec_CPU" type="text" placeholder="CPU recomendado" value="<%= typeof game !== 'undefined' && game && game.rec_CPU ? game.rec_CPU : '' %>">
                    
                    <label for="rec_RAM">RAM:</label>
                    <input id="rec_RAM" name="rec_RAM" type="text" placeholder="RAM recomendada" value="<%= typeof game !== 'undefined' && game && game.rec_RAM ? game.rec_RAM : '' %>">  
                    
                    <label for="rec_GPU">GPU:</label>
                    <input id="rec_GPU" name="rec_GPU" type="text" placeholder="GPU recomendada" value="<%= typeof game !== 'undefined' && game && game.rec_GPU ? game.rec_GPU : '' %>">
                    
                    <label for="rec_ALM">Almacenamiento:</label>
                    <input id="rec_ALM" name="rec_ALM" type="text" placeholder="Almacenamiento recomendado" value="<%= typeof game !== 'undefined' && game && game.rec_ALM ? game.rec_ALM : '' %>">
                </div>

                <button type="submit" class="btn" style="grid-column:1/-1;margin-top:20px;">Actualizar Juego</button>
            </form>
        <% } %>

        <!-- Si no hay juego pero hubo búsqueda, mostrar mensaje -->
        <% if (typeof searched !== 'undefined' && searched && (!game || !game.id)) { %>
            <p style="color:var(--muted);text-align:center;">No se encontró el juego. Intenta con otro nombre.</p>
        <% } %>
    </main>

        <footer>
            <p>&copy; 2025 BaseGamer</p>
            <p>Contacto: <a href="mailto:BaseGamer.EBA@hotmail.com">BaseGamer.EBA@hotmail.com</a></p>
        </footer>
    </div>
        <script>
            // Sugerencias en vivo para /modificar
            (function(){
                const input = document.getElementById('searchModificar');
                const box = document.getElementById('suggestionsModificar');
                if (!input || !box) return;
                let t;
                input.addEventListener('input', () => {
                    clearTimeout(t);
                    const q = input.value.trim();
                    if (!q) { box.innerHTML = ''; return; }
                    t = setTimeout(async () => {
                        try {
                            const res = await fetch(`/buscar?q=${encodeURIComponent(q)}`);
                            const data = await res.json();
                            const items = (data.results || []).slice(0,8).map(r => `
                                <a href="/modificar?q=${encodeURIComponent(r.nombre || '')}" class="suggestion-item" style="display:flex;gap:10px;align-items:center;padding:8px;border-radius:8px;background:rgba(255,255,255,0.04);text-decoration:none;color:#fff;margin-top:6px">
                                    <img src="${r.imagen || ''}" alt="${r.nombre || ''}" style="width:44px;height:44px;object-fit:cover;border-radius:6px;">
                                    <div>
                                        <div style=\"font-weight:600\">${r.nombre || ''}</div>
                                        <div style=\"color:#9AA0A6;font-size:12px;\">$${r.precio || ''}</div>
                                    </div>
                                </a>`).join('');
                            box.innerHTML = items;
                        } catch (e) {
                            box.innerHTML = '';
                        }
                    }, 250);
                });
            })();
        </script>
</body>
</html>
