<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Base Gamer — Prototipo</title>

  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700&family=Orbitron:wght@500;700&family=Roboto:wght@300;400;500&display=swap" rel="stylesheet">

  <!-- Hoja de estilos externa -->
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <div class="container">

    <header>
      <div class="logo">
        <div class="mark">BG</div>
        <div>
          <h1>BaseGamer</h1>
          <p>Añadir - Modificar - Juegos</p>
        </div>
      </div>

      <nav>
        <a href="/modificar">Modificar</a>
        <a href="/agregar">Agregar</a>
        <a href="/home">Inicio</a>
        <a href="/catalogo">Catálogo</a>

        <form class="search" role="search" method="get" action="/catalogo" style="position:relative;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden><path d="M21 21l-4.35-4.35" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <input name="q" id="searchCatalogo" placeholder="Buscar juegos..." aria-label="Buscar" value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>">
          <button type="submit" style="display:none"></button>
          <div id="suggestionsCatalogo" class="search-suggestions" style="position:absolute;top:42px;left:0;right:0;z-index:10"></div>
        </form>
      </nav>
    </header>

    <main>
      <section id="ofertas" class="section">
  <h2><%= typeof searchQuery !== 'undefined' && searchQuery ? 'Resultados de búsqueda para "' + searchQuery + '"' : 'Productos:' %></h2> 
        <div class="grid">
          <% if (juegos && juegos.length > 0) { %>
            <% juegos.forEach(juego => { %>
              <!-- Card para <%= juego.nombre %> -->
              <article class="card">
                <div class="thumb"><img src="<%= juego.imagen %>" alt="<%= juego.nombre %>"></div>
                <h4 class="title"><%= juego.nombre %></h4>
                <div class="meta">
                  <div class="price">$<%= juego.precio %></div>
                </div>
                <p style="color:var(--muted);font-size:13px;margin:6px 0 0;"><%= juego.descripcion %></p>
                <div class="actions">
                  <a href="/detalles/<%= juego.id %>" class="small-btn add">Detalles</a>
                </div>
              </article>
            <% }); %> 
          <% } else { %>
            <p style="color:var(--muted);text-align:center;width:100%;">
              <% if (typeof searchQuery !== 'undefined' && searchQuery) { %>
                No se encontraron productos que coincidan con "<%= searchQuery %>".
              <% } else { %>
                No hay juegos disponibles en este momento.
              <% } %>
            </p>
          <% } %>
        </div>
      </section>

      <footer>
        © 2025 BaseGamer — Diseño prototipo • Todos los derechos reservados.
      </footer>

    </main>
  </div>
  <script>
    // Live suggestions para /catalogo
    (function(){
      const input = document.getElementById('searchCatalogo');
      const box = document.getElementById('suggestionsCatalogo');
      if (!input || !box) return;
      let t;
      input.addEventListener('input', () => {
        clearTimeout(t);
        const q = input.value.trim();
        if (!q) { box.innerHTML = ''; return; }
        t = setTimeout(async () => {
          try {
            const res = await fetch(`/buscar?q=${encodeURIComponent(q)}`);
            const data = await res.json();
            const items = (data.results || []).slice(0,6).map(r => `
              <a href="/detalles/${r.id}" class="suggestion-item">
                <img src="${r.imagen}" alt="${r.nombre}" class="suggestion-thumb">
                <div class="suggestion-text">
                  <div class="suggestion-title">${r.nombre}</div>
                  <div class="suggestion-price">$${r.precio || ''}</div>
                </div>
              </a>`).join('');
            box.innerHTML = items;
          } catch (e) {
            box.innerHTML = '';
          }
        }, 250);
      });
    })();
  </script>
</body>
</html>