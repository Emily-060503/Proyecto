# Variables de entorno de ejemplo# Configuración de Firebase

# Copia este archivo como .env y completa con tus credenciales reales# Copia este archivo a .env y completa con tus credenciales de Firebase



# Configuración de FirebaseFIREBASE_API_KEY=tu_api_key_aqui

FIREBASE_API_KEY=tu_api_key_aquiFIREBASE_AUTH_DOMAIN=tu_auth_domain_aqui

FIREBASE_AUTH_DOMAIN=tu_proyecto.firebaseapp.comFIREBASE_PROJECT_ID=tu_project_id_aqui

FIREBASE_PROJECT_ID=tu_proyecto_idFIREBASE_STORAGE_BUCKET=tu_storage_bucket_aqui

FIREBASE_STORAGE_BUCKET=tu_proyecto.firebasestorage.appFIREBASE_MESSAGING_SENDER_ID=tu_messaging_sender_id_aqui

FIREBASE_MESSAGING_SENDER_ID=tu_sender_idFIREBASE_APP_ID=tu_app_id_aqui

FIREBASE_APP_ID=tu_app_id
FIREBASE_MEASUREMENT_ID=tu_measurement_id

# Configuración del servidor
PORT=3000
NODE_ENV=development
