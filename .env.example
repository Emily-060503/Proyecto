## Ejemplo de variables de entorno (.env)
# Copia este archivo como ".env" y completa con tus credenciales reales.

# Firebase
FIREBASE_API_KEY=tu_api_key_aqui
FIREBASE_AUTH_DOMAIN=tu_auth_domain_aqui
FIREBASE_PROJECT_ID=tu_project_id_aqui
FIREBASE_STORAGE_BUCKET=tu_storage_bucket_aqui
FIREBASE_MESSAGING_SENDER_ID=tu_messaging_sender_id_aqui
FIREBASE_APP_ID=tu_app_id_aqui
FIREBASE_MEASUREMENT_ID=tu_measurement_id

# Sesiones (elige una cadena aleatoria segura en producción)
SESSION_SECRET=cadena_super_secreta

# Servidor
PORT=3000
NODE_ENV=development
